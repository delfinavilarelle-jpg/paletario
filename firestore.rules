rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Valida la forma de cada paleta antes de guardarla
    function paletaValida(d) {
      return d.keys().hasOnly(['name', 'colors', 'mood', 'source', 'status', 'favorite', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.colors is list && d.colors.size() >= 2 && d.colors.size() <= 8
        && d.mood is string && d.mood.size() > 0 && d.mood.size() <= 30
        && d.status in ['idea', 'prueba', 'aprobada']
        && d.favorite is bool
        && (!('source' in d) || (d.source is string && d.source.size() <= 120));
    }

    // Cada visitante (anónimo) solo accede a sus propias paletas
    match /users/{userId}/palettes/{paletteId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && paletaValida(request.resource.data);
    }
  }
}
